# group-ops-bot environment file (test server 219.151.177.33)
# Install to: /etc/group-ops/group-ops-bot.env  (root:root, chmod 600)
# Credentials live ONLY in this file on the server. Never commit, never upload.

# ---- listening ----
GOPS_CALLBACK_PORT=12334
GOPS_EXTERNAL_BASE_URL=http://219.151.177.33:12334

# ---- admin backend: localhost only (section 2.10, no public mapping) ----
GOPS_ADMIN_HOST=127.0.0.1
GOPS_ADMIN_PORT=18003

# ---- initial admin bootstrap (forced password change on first login) ----
# TODO before first start: replace both placeholders.
GOPS_ADMIN_USERNAME=REPLACE_ME
GOPS_ADMIN_PASSWORD=REPLACE_ME

# ---- data dir (SQLite state + exports; the only writable path) ----
GOPS_DATA_DIR=/opt/group-ops/data

# ---- P0 group bind admins (comma-separated phones; empty = in-chat "绑定"
# unusable for everyone, fail-closed; groups can still be bound from the
# admin backend "discovered" list) ----
GOPS_BIND_ADMIN_PHONES=REPLACE_ME

# ---- MCP Server: live on 127.0.0.1:18001 (systemd group-ops-mcp; MySQL DDL
# executed and verified 2026-10-14). Submissions no longer fall to class C
# by default; C-class recovery remains op.query_by_request.
GOPS_MCP_BASE_URL=http://127.0.0.1:18001
GOPS_MCP_TIMEOUT=30

# ---- scheduler: OFF during bring-up. MCP is live (2026-10-14) but platform
# push capability is still unconfirmed (adapter fail-closed, push §5.2).
# Set 1 only after push capability is confirmed on the target platform.
GOPS_ENABLE_SCHEDULER=0

GOPS_LOG_LEVEL=INFO
