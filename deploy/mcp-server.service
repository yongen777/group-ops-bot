[Unit]
Description=group-ops MCP Server (SSE :18001 loopback-only, MySQL qsm backend)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=groupops
Group=groupops
WorkingDirectory=/opt/group-ops/repo
EnvironmentFile=/etc/group-ops/mcp-server.env
ExecStart=/opt/group-ops/venv/bin/python -m mcp_server.server
Restart=always
RestartSec=3

# fail-closed 语义：缺 GOPS_MYSQL_* 时进程自行退出（非零码），systemd 记录退出原因；
# ⛔ 不存在"无库降级模式"——连接不上 MySQL 时工具调用如实报错，机器人侧归 C 类。

# hardening: read-only filesystem; this service writes nothing to disk
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/group-ops/data

# logs go to journal (journalctl -u group-ops-mcp)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=group-ops-mcp

[Install]
WantedBy=multi-user.target
